{
  "name": "wingman",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:ts && npm run test:windows && npm run test:packaging && npm run test:rust",
    "test:ts": "tsx src/terminal-input.test.ts && tsx src/terminal-paste.test.ts && tsx src/terminal-shortcuts.test.ts && tsx src/terminal-security.test.ts",
    "test:windows": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File src-tauri/tests/layout_regression.tests.ps1",
    "test:packaging": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File src-tauri/tests/sidecar_packaging.tests.ps1",
    "test:release-bundle": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File src-tauri/tests/release_bundle_contract.tests.ps1",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "vite": "^6.0.3"
  }
}
