{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wingman",
  "version": "0.1.0",
  "identifier": "com.wingman.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wingman",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#071018"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'none'; media-src 'none'; form-action 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "src/powershell_runner_transport.ps1": "powershell_runner_transport.ps1"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
